---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-line">
  <div class="container-x flex flex-col gap-16 py-16 md:py-20">
    <a href="/contact" class="group block w-fit">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-muted">Have a role in mind?</p>
      <p class="mt-3 font-display text-5xl leading-none tracking-tight sm:text-7xl md:text-8xl">
        Let's talk
        <span
          aria-hidden="true"
          class="inline-block text-accent transition-transform duration-700 ease-out-expo group-hover:translate-x-3 group-hover:rotate-90"
          >✦</span
        >
      </p>
    </a>

    <div class="flex flex-col-reverse gap-8 text-sm text-muted md:flex-row md:items-end md:justify-between">
      <p>© {year} {site.name}</p>
      <SocialLinks withEmail class="text-ink" />
    </div>
  </div>
</footer>
