---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  number: string;
}

const { project, number } = Astro.props;
const { title, summary, year, stack, cover, coverAlt } = project.data;
---

<article class="group relative">
  <a href={`/work/${project.id}`} class="block">
    <div
      transition:name={`cover-${project.id}`}
      class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-surface transition-[translate,rotate,box-shadow] duration-700 ease-out-expo group-hover:-translate-y-2 group-hover:-rotate-[0.6deg] group-hover:shadow-[0_30px_60px_-30px_rgb(0_0_0/0.35)]"
    >
      {
        cover ? (
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="h-full w-full object-cover transition-transform duration-1000 ease-out-expo group-hover:scale-[1.03]"
          />
        ) : (
          <div class="flex h-full flex-col justify-between p-6 md:p-8" aria-hidden="true">
            <span class="font-display text-[clamp(4rem,12vw,9rem)] leading-none tracking-tight text-line">
              {number}
            </span>
            <span class="self-end text-4xl text-accent transition-transform duration-1000 ease-out-expo group-hover:rotate-180">
              ✦
            </span>
          </div>
        )
      }
    </div>

    <div class="mt-6 flex items-baseline justify-between gap-4">
      <h3 class="font-display text-2xl tracking-tight md:text-3xl">
        <span
          class="bg-linear-to-r from-accent to-accent bg-[length:0%_1px] bg-left-bottom bg-no-repeat pb-1 transition-[background-size] duration-700 ease-out-expo group-hover:bg-[length:100%_1px]"
        >
          {title}
        </span>
      </h3>
      <span class="shrink-0 text-sm tabular-nums text-muted">{number} / {year}</span>
    </div>
    <p class="mt-3 max-w-prose leading-relaxed text-muted">{summary}</p>
    <p class="mt-4 text-sm text-muted">{stack.join(' · ')}</p>
  </a>
</article>
