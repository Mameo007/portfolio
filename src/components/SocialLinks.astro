---
import { site, socials } from '../data/site';
import SocialIcon from './SocialIcon.astro';

interface Props {
  class?: string;
  /** Include the email address alongside the social profiles. */
  withEmail?: boolean;
}

const { class: className, withEmail = false } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center gap-x-8 gap-y-3', className]}>
  {
    withEmail && (
      <li>
        <a
          href={`mailto:${site.email}`}
          class="group inline-flex items-center gap-1 font-medium transition-colors hover:text-accent"
        >
          Email
          <span
            aria-hidden="true"
            class="inline-block transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          >
            ↗
          </span>
        </a>
      </li>
    )
  }
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          title={s.label}
          class="-m-2 inline-flex p-2 transition-[color,translate] duration-300 hover:-translate-y-0.5 hover:text-accent"
        >
          <SocialIcon name={s.label} class="size-6" />
          <span class="sr-only">{s.label} (opens in a new tab)</span>
        </a>
      </li>
    ))
  }
</ul>
