---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="container-x pt-36 md:pt-48">
    <p class="reveal text-sm font-medium uppercase tracking-[0.2em] text-muted">Contact</p>
    <h1 class="reveal mt-6 font-display text-[clamp(3rem,10vw,7.5rem)] leading-[0.95] tracking-[-0.03em]">
      Let's build<br /><em class="text-accent">something</em> together
    </h1>
  </section>

  <section class="container-x mt-20 grid gap-20 md:mt-28 md:grid-cols-12 md:gap-8">
    <aside class="reveal flex flex-col gap-12 md:col-span-4">
      <p class="text-lg leading-relaxed text-muted">
        Whether you're hiring, have a project in mind, or just want to say hi, my inbox is open. I usually reply
        within a day or two.
      </p>

      <div>
        <h2 class="text-sm font-medium uppercase tracking-[0.2em] text-muted">Email</h2>
        <a
          href={`mailto:${site.email}`}
          class="mt-3 inline-block break-all font-display text-2xl tracking-tight underline decoration-accent decoration-1 underline-offset-[6px] hover:text-accent"
        >
          {site.email}
        </a>
      </div>

      <div>
        <h2 class="text-sm font-medium uppercase tracking-[0.2em] text-muted">Elsewhere</h2>
        <SocialLinks class="mt-3" />
      </div>
    </aside>

    <div class="reveal md:col-span-7 md:col-start-6" style="--reveal-delay:120ms">
      <ContactForm />
    </div>
  </section>
</BaseLayout>
